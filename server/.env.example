# Copy this file to .env and adjust as needed.
# Port the API listens on.
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server + your deploy URL).
CLIENT_ORIGIN=http://localhost:8080,http://localhost:4173
# Secret used to sign auth tokens. CHANGE THIS to a long random string in production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# How long a login stays valid.
JWT_EXPIRES_IN=7d
# Where the SQLite database file lives (relative to the server folder).
DATABASE_FILE=./data/swadeshi.db
